{
  "kind": "collectionType",
  "collectionName": "contact_submissions",
  "info": { "singularName": "contact-submission", "pluralName": "contact-submissions", "displayName": "Contact submission" },
  "options": { "draftAndPublish": false },
  "pluginOptions": { "content-manager": { "visible": true } },
  "attributes": {
    "name": { "type": "string", "required": true, "private": true },
    "mobile": { "type": "string", "required": true, "private": true },
    "email": { "type": "email", "private": true },
    "subject": { "type": "string", "required": true, "private": true },
    "message": { "type": "text", "required": true, "private": true },
    "ipHash": { "type": "string", "required": true, "private": true },
    "status": { "type": "enumeration", "enum": ["new", "read", "resolved"], "default": "new" }
  }
}
