{
  "kind": "collectionType",
  "collectionName": "testimonials",
  "info": { "singularName": "testimonial", "pluralName": "testimonials", "displayName": "Testimonial" },
  "options": { "draftAndPublish": true },
  "attributes": {
    "quote": { "type": "text", "required": true, "maxLength": 1000 },
    "author": { "type": "string", "required": true, "maxLength": 100 },
    "role": { "type": "string", "maxLength": 100 },
    "rating": { "type": "integer", "min": 1, "max": 5, "default": 5 },
    "route": { "type": "relation", "relation": "manyToOne", "target": "api::route.route", "inversedBy": "testimonials" }
  }
}
