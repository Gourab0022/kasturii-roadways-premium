{
  "kind": "collectionType",
  "collectionName": "cities",
  "info": { "singularName": "city", "pluralName": "cities", "displayName": "City" },
  "options": { "draftAndPublish": true },
  "pluginOptions": { "content-manager": { "visible": true }, "content-type-builder": { "visible": true } },
  "attributes": {
    "name": { "type": "string", "required": true, "unique": true, "maxLength": 100 },
    "slug": { "type": "uid", "targetField": "name", "required": true },
    "code": { "type": "string", "maxLength": 10 },
    "isActive": { "type": "boolean", "default": true },
    "stops": { "type": "relation", "relation": "oneToMany", "target": "api::stop.stop", "mappedBy": "city" },
    "originRoutes": { "type": "relation", "relation": "oneToMany", "target": "api::route.route", "mappedBy": "origin" },
    "destinationRoutes": { "type": "relation", "relation": "oneToMany", "target": "api::route.route", "mappedBy": "destination" }
  }
}
